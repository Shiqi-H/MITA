# ── Server-side LLM ───────────────────────────────────────────────────────────

# API key for the LLM backend (NEWAPI or any OpenAI-compatible provider)
NEWAPI_API_KEY=

# Base URL of the LLM API endpoint (no trailing slash; /v1 is appended automatically)
NEWAPI_BASE_URL=

# Model ID used for all server-side LLM calls (generate-info, compare, disambiguation)
NEWAPI_MODEL=

# ── Client-side intent engine ─────────────────────────────────────────────────

# Controls how user utterances are parsed.
# "llm"   — routes input through the server-side LLM intent parser (recommended)
# "local" — keyword-only matching, no LLM call (default when unset)
VITE_INTENT_ENGINE=
